# ── 生产系统（运行在服务器上时改为服务器 IP）
CHAT_API_URL=http://localhost:8000

# ── 阿里百炼 API Key（同生产项目 .env，RAGAS Judge 使用）
OPENAI_API_KEY=your_aliyun_dashscope_key

# ── Qwen3.7-Flash API Key（Agent 1 QA 生成专用）
QA_GEN_API_KEY=your_qwen_flash_key
QA_GEN_MODEL=Qwen3.7-Flash

# ── Milvus
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=wow_knowledge_base_v2

# ── Redis（flywheel_ingest.py 用，与生产同密码）
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=your_redis_password

# ── RAGAS Judge LLM
RAGAS_JUDGE_MODEL=qwen-max

# ── ONNX 嵌入模型路径（默认指向同级 pythonProject）
# EMBED_MODEL_PATH=../pythonProject/models/nomic-embed-text

# ── 飞轮批次参数
FLYWHEEL_BATCH_SIZE=20

# ── 请求参数
CHAT_TIMEOUT=120
CHAT_DELAY=1.5
RAGAS_WORKERS=4
RAGAS_TIMEOUT=300
